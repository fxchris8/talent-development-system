# ================================================
# Production Environment Variables
# ================================================
# 
# PENTING: 
# - JANGAN COMMIT FILE INI KE GIT!
# - Copy dari .env.prod.example
# - Gunakan values yang aman untuk production
#

# Database Credentials (GANTI DENGAN VALUES YANG AMAN!)
MYSQL_ROOT_PASSWORD=your-super-secret-root-password-here
DB_USER=tds_user_prod
DB_PASSWORD=your-super-secret-db-password-here
DB_NAME=tds

# JWT Secret (GUNAKAN RANDOM STRING YANG PANJANG!)
JWT_SECRET=your-super-long-random-jwt-secret-minimum-32-characters-here

# LLM API
GROQ_API_KEY=your-groq-api-key-here

# SSO Integration (isi sesuai konfigurasi SSO Portal)
# SSO_BASE_URL dipakai backend container untuk server-to-server call
# Jika SSO backend berjalan di host machine dari Docker, gunakan host.docker.internal
SSO_BASE_URL=http://host.docker.internal:5000
SSO_FRONTEND_URL=https://sso.yourdomain.com
SSO_CLIENT_ID=client_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SSO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SSO_CALLBACK_URL=https://api.yourdomain.com/api/auth/sso/callback
FRONTEND_URL=https://app.yourdomain.com

# Frontend API Endpoint
# Ganti dengan domain/IP production Anda
NEXT_PUBLIC_API_ENDPOINT=https://api.yourdomain.com

# URL publik backend, dipakai untuk link file materi (PPT/PDF) yang disimpan ke database.
# Biasanya sama dengan NEXT_PUBLIC_API_ENDPOINT. Jika kosong, nilai NEXT_PUBLIC_API_ENDPOINT dipakai.
BACKEND_PUBLIC_URL=https://api.yourdomain.com

# Database eksternal (docker-compose.prod.yml tidak menjalankan MySQL sendiri)
DB_HOST=your-database-host
DB_PORT=3306

# API Apollo (opsional; kosong = default di kode)
APOLLO_API_BASE_URL=

# AI generator (LLM via OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_PROVIDER=

# Origin tambahan yang boleh memanggil API selain FRONTEND_URL (pisahkan dengan koma), opsional
CORS_ALLOWED_ORIGINS=

# Seeder saat backend start: auto (hanya tabel kosong) | always | never
SEED_ON_START=auto
